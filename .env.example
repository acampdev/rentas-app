# Configuración segura por defecto: el navegador usa /api y /auth del mismo origen.
# En producción, el servidor web debe reenviar esas rutas al backend.
VITE_API_URL=
API_PROXY_TARGET=
VITE_ENABLE_DEBUG_LOGS=false

# Navegador directo: use obligatoriamente HTTPS y habilite CORS en el backend.
# VITE_API_URL=https://api.ejemplo.gob.pe

# API_PROXY_TARGET es solo para desarrollo; configure localmente el destino del
# proxy de Vite si no dispone de un backend HTTPS con CORS.
VITE_APP_TITLE=Sistema de Gestión Tributaria
VITE_APP_VERSION=1.0.0
VITE_ENABLE_DEBUG=false
